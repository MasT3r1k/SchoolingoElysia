{
  "name": "schoolingo-elysia",
  "version": "1.0.0",
  "description": "Schoolingo API built with Elysia",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "build": "bun build ./index.ts --outdir ./dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "db:create": "bun run src/db/migrations.ts create",
    "db:drop": "bun run src/db/migrations.ts drop"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elysiajs/cors": "latest",
    "@elysiajs/static": "^1.4.7",
    "@elysiajs/swagger": "latest",
    "@simplewebauthn/server": "^13.1.1",
    "@sinclair/typebox": "^0.34.41",
    "@types/html-pdf-node": "^1.0.2",
    "@types/nodemailer": "^7.0.2",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.2",
    "dotenv": "latest",
    "elysia": "latest",
    "elysia-helmet": "^3.0.0",
    "elysia-ip": "latest",
    "elysia-rate-limit": "^4.4.0",
    "elysia-xss": "^1.0.3",
    "html-pdf-node": "^1.0.8",
    "kysely": "latest",
    "ldapts": "^8.1.7",
    "mime-types": "^3.0.2",
    "moment": "^2.30.1",
    "mysql2": "latest",
    "nodemailer": "^7.0.9",
    "otpauth": "^9.4.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "bun-types": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "prettier": "latest",
    "typescript": "latest"
  },
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  }
}
