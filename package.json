{
  "name": "schoolingo-elysia",
  "version": "1.0.0",
  "description": "Schoolingo API built with Elysia",
  "main": "index.ts",
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "build": "bun build ./index.ts --outdir ./dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "db:create": "bun run src/db/migrations.ts create",
    "db:drop": "bun run src/db/migrations.ts drop"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elysiajs/cors": "latest",
    "@elysiajs/swagger": "latest",
    "@simplewebauthn/server": "^13.1.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "latest",
    "elysia": "latest",
    "elysia-ip": "latest",
    "kysely": "latest",
    "mysql2": "latest",
    "otpauth": "^9.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "bun-types": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "prettier": "latest",
    "typescript": "latest"
  },
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  }
}
